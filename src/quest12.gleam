import board
import gleam/dict
import gleam/int
import gleam/list
import gleam/result
import gleam/set
import gleam/string

fn parse_board(inp: String) {
  inp
  |> string.split("\n")
  |> list.map(fn(line) {
    string.to_graphemes(line)
    |> list.map(fn(g) { int.parse(g) |> result.unwrap(-1) })
  })
  |> board.create_board()
}

pub fn part1(inp: String) {
  let piles = parse_board(inp)
  let ignited = ignite(piles, board.Pos(0, 0), set.from_list([board.Pos(0, 0)]))
  set.size(ignited)
}

fn ignite(piles: board.Board(Int), pos: board.Pos, ignited: set.Set(board.Pos)) {
  let neighbours = board.get_neighbours_4(piles, pos)
  let this = dict.get(piles.board_el, pos) |> result.unwrap(-1)
  list.fold(neighbours, ignited, fn(i_acc, neighbour) {
    case set.contains(i_acc, neighbour) {
      True -> i_acc
      False -> {
        let ignited = set.insert(i_acc, neighbour)
        let n_val = dict.get(piles.board_el, neighbour) |> result.unwrap(-1)
        case n_val <= this {
          True -> {
            let n_ignited = ignite(piles, neighbour, ignited)
            set.union(n_ignited, i_acc)
          }
          False -> i_acc
        }
      }
    }
  })
}

pub fn part2(inp: String) {
  let piles = parse_board(inp)
  let ignited1 =
    ignite(piles, board.Pos(0, 0), set.from_list([board.Pos(0, 0)]))
  let ignited2 =
    ignite(piles, board.Pos(piles.height - 1, piles.width - 1), ignited1)
  set.size(set.union(ignited1, ignited2))
}

pub fn part3(inp: String) {
  let piles = parse_board(inp)
  let #(_max_ign1, ignited1) =
    find_max_ignited(piles, set.new())
    |> echo

  let #(_max_ign2, ignited2) =
    find_max_ignited(piles, ignited1)
    |> echo
  let union =
    set.union(ignited1, ignited2)
    |> echo

  let #(_max3, ignited3) = find_max_ignited(piles, union)
  let union = set.union(union, ignited3)
  set.size(union)
}

fn find_max_ignited(
  piles: board.Board(Int),
  ignore,
) -> #(Int, set.Set(board.Pos)) {
  list.fold(list.range(0, piles.width - 1), #(0, set.new()), fn(r_acc, row) {
    let #(max_i, visited) = r_acc
    let max_ignited_col =
      list.fold(list.range(0, piles.height - 1), r_acc, fn(col_acc, col) {
        let pos = board.Pos(row, col)
        case set.contains(ignore, pos) {
          True -> col_acc
          False -> {
            let ignited = ignite(piles, pos, set.from_list([pos]))
            let ign_count = set.size(ignited)
            let #(curr_max, _curr_ignited) = col_acc
            case ign_count >= curr_max {
              True -> {
                echo ign_count
                #(ign_count, ignited)
              }
              False -> col_acc
            }
          }
        }
      })
  })
}

